# Copie este arquivo para ".env" (os instaladores fazem isso) e preencha.
# O .env fica só no seu computador e nunca é enviado ao GitHub.

# E-mail (Gmail): use uma "senha de app" de 16 letras, não a senha normal.
# Crie em https://myaccount.google.com/apppasswords
SMTP_USUARIO=seu.email@gmail.com
SMTP_SENHA=
# Para quem enviar (deixe vazio para mandar para o próprio SMTP_USUARIO)
EMAIL_PARA=

# Opcional: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
